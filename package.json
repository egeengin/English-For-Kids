{
  "name": "english-for-kids",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && vite build --outDir docs",
    "lint": "oxlint",
    "test": "node --test tests/*.test.mjs",
    "test:coverage": "node --test --experimental-test-coverage tests/*.test.mjs",
    "preview": "vite preview",
    "audio:neural": "python3 scripts/generate_neural_audio.py",
    "audio:gemini": "node scripts/generate_gemini_audio.mjs",
    "audio:generate": "node scripts/generate_all_audio.mjs",
    "audio:azure:en": "node scripts/generate_azure_audio.mjs en",
    "audio:azure:tr": "node scripts/generate_azure_audio.mjs tr",
    "audio:azure:de": "node scripts/generate_azure_audio.mjs de",
    "audio:elevenlabs:en": "node scripts/generate_elevenlabs_audio.mjs en",
    "audio:elevenlabs:tr": "node scripts/generate_elevenlabs_audio.mjs tr",
    "audio:elevenlabs:de": "node scripts/generate_elevenlabs_audio.mjs de"
  },
  "dependencies": {
    "autoprefixer": "^10.5.5",
    "canvas-confetti": "^1.9.4",
    "lucide-react": "^1.41.0",
    "postcss": "^8.5.28",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^3.4.19"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "oxlint": "^1.79.0",
    "vite": "^8.2.2"
  }
}
